VIEWER_USER=spartan
# O admin da página é o VIEWER_USER. A senha inicial é sorteada na primeira subida
# do site e aparece uma vez no log (e em /app/data/admin-inicial.txt, no volume).
# Esqueceu? ./admin-reset.sh link spartan
SESSION_SECRET=troque-este-segredo
MTX_API_URL=http://spartan-live-motor:9997
MTX_HLS_URL=http://spartan-live-motor:8888
MTX_USER=site
MTX_PASSWORD=troque-esta-senha-de-leitura
# Segredo que o motor manda em /api/mtx-auth quando authMethod for http.
MTX_AUTH_SECRET=troque-este-segredo-do-motor
PORT=8080
# Endereço público do site, só para o ./admin-reset.sh montar a mensagem pronta:
# SITE_URL=https://spartanlive.exemplo.com
