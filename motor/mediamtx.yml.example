logLevel: info

api: true
apiAddress: :9997

rtsp: false
webrtc: false
srt: false
moq: false
playback: false
metrics: false
pprof: false

rtmp: true
rtmpAddress: :1935

hls: true
hlsAddress: :8888
hlsVariant: lowLatency
hlsSegmentDuration: 1s
hlsPartDuration: 200ms
hlsSegmentCount: 120

# Cada pessoa publica com a própria conta do site: o motor pergunta ao site.
# O secret abaixo é o MTX_AUTH_SECRET do .env, o mesmo que o site confere.
authMethod: http
authHTTPAddress: http://spartan-live-site:8080/api/mtx-auth?secret=TROQUE_SEGREDO_MOTOR

# Motor antigo (um único usuário publisher, para o .exe velho): troque as duas
# linhas acima por estas e descomente o bloco todo.
# authMethod: internal
# authInternalUsers:
#   - user: any
#     pass:
#     ips: []
#     permissions: []
#
#   - user: publisher
#     pass: TROQUE_SENHA_PUBLISHER
#     ips: []
#     permissions:
#       - action: publish
#
#   - user: site
#     pass: TROQUE_SENHA_SITE
#     ips: []
#     permissions:
#       - action: read
#       - action: api

pathDefaults:
  overridePublisher: true

paths:
  all_others:
